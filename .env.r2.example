# Copie para .env.r2 (não versionar) e preencha com os valores do Cloudflare R2.
# Depois rode: npm run supabase:set-r2-secrets

R2_BUCKET=nome-do-bucket
R2_ACCOUNT_ID=seu_account_id
R2_ACCESS_KEY_ID=seu_access_key_id
R2_SECRET_ACCESS_KEY=seu_secret_access_key
# Opcional — gerado automaticamente se omitido:
# R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
